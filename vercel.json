{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix EsportsClash.Web install",
  "buildCommand": "npm --prefix EsportsClash.Web run build",
  "outputDirectory": "EsportsClash.Web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

